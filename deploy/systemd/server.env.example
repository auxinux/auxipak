# /etc/auxipak-server/server.env (propriétaire root:auxipak, droits 0640)
AUXIPAK_ENV=production
AUXIPAK_DATABASE_URL=postgres://auxipak:MOT_DE_PASSE@127.0.0.1:5432/auxipak
AUXIPAK_BIND=127.0.0.1:8080
AUXIPAK_PUBLIC_URL=https://pak.auxinux.ca
AUXIPAK_DATA_DIR=/var/lib/auxipak-server
AUXIPAK_KEYS_DIR=/etc/auxipak-server/keys
AUXIPAK_TRUSTED_PROXIES=127.0.0.1,::1
AUXIPAK_REQUIRE_DISTINCT_APPROVER=true
AUXIPAK_LOG=info
