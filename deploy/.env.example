# Configuration de production d'AuxiPak Server (docker-compose.yml).
# Copier en .env, renseigner chaque valeur, puis : chmod 600 .env
# Ne JAMAIS versionner le fichier .env.

# URL publique HTTPS du service.
AUXIPAK_PUBLIC_URL=https://pak.auxinux.ca

# Mot de passe PostgreSQL : générer une valeur aléatoire, par exemple :
#   openssl rand -hex 32   (hexadécimal : sans caractère à échapper dans l'URL)
POSTGRES_PASSWORD=

# Répertoire de l'hôte contenant les clés du serveur (voir docs/SIGNING.md) :
# root.json, package-keys.json, targets.pem, snapshot.pem, timestamp.pem,
# package-signing.pem — propriétaire 10001:10001, fichiers .pem en 0600.
AUXIPAK_KEYS_HOST_DIR=/etc/auxipak-server/keys

# L'approbateur d'une demande doit être distinct de son auteur (recommandé).
AUXIPAK_REQUIRE_DISTINCT_APPROVER=true

# Taille maximale d'un paquet soumis (octets) — 8 Gio par défaut.
AUXIPAK_MAX_UPLOAD_BYTES=8589934592

# Niveau de journalisation (error, warn, info, debug).
AUXIPAK_LOG=info

# Mandataire HTTPS sur une AUTRE machine (panneau d'hébergement distant) :
#   AUXIPAK_BIND=0.0.0.0
#   AUXIPAK_TRUSTED_PROXIES=172.30.0.1,<IP du mandataire>
# et n'autoriser que cette IP sur le port 8080 (voir docs/DEPLOYMENT.md).
# AUXIPAK_BIND=127.0.0.1
# AUXIPAK_TRUSTED_PROXIES=172.30.0.1
